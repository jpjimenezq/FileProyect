# Copia este archivo a .env. Solo lo lee el backend.

# ── IA (Resumir, Traducir, mejora de PDF a Markdown) ──
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# AI_DAILY_CHARS=2000000        # tope diario global de caracteres enviados a la IA

# ── Cuentas ──
# SESSION_SECRET=               # opcional: si no se pone, se genera y se guarda en DATA_DIR
# DATA_DIR=./server/data        # base de datos SQLite y clave de sesión
# PUBLIC_URL=https://tudominio.com   # URL pública (enlaces de Stripe, cookies seguras)
# TRUST_PROXY=1                 # pon 1 si hay un proxy inverso delante (para ver la IP real)

# ── Correo (recuperar contraseña) ──
# SMTP_URL=smtps://usuario:clave@smtp.tuproveedor.com:465
# MAIL_FROM="FileProyect <no-reply@tudominio.com>"
# Sin SMTP_URL, en desarrollo el enlace de recuperación se imprime en la consola del servidor.

# ── Cobros con Stripe (suscripción Pro) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # endpoint: PUBLIC_URL/api/billing/webhook
# STRIPE_PRICE_MONTH=price_...          # precio recurrente mensual (4,99 €, impuestos incluidos)
# STRIPE_PRICE_YEAR=price_...           # precio recurrente anual (39,99 €, impuestos incluidos)

# ── Solo desarrollo ──
# BILLING_DEV=1                 # activa /api/billing/dev-upgrade para probar Pro sin Stripe. NUNCA en producción

# PORT=3001
# JOBS=3
