# Copia este archivo a .env. Las variables VITE_* las lee también el navegador (Vite); el resto solo el backend.

# ── IA (Resumir, Traducir, mejora de PDF a Markdown) ──
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# AI_DAILY_CHARS=2000000        # tope diario global de caracteres enviados a la IA

# ── Cuentas ──
# SESSION_SECRET=               # opcional: si no se pone, se genera y se guarda en DATA_DIR
# DATA_DIR=./server/data        # base de datos SQLite y clave de sesión
# PUBLIC_URL=https://tudominio.com   # URL pública (enlaces de Stripe, cookies seguras)
# TRUST_PROXY=1                 # pon 1 si hay un proxy inverso delante (para ver la IP real)

# ── Supabase (inicio de sesión, usuarios y panel de administración) ──
# Con SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY el servidor usa Supabase; sin ellas sigue con SQLite y cookies.
# En local: `npx supabase start` y copia aquí los valores de `npx supabase status -o env` (mejor en .env.local, ignorado por git).
# Desde el contenedor de Docker de la app, Supabase local se alcanza con http://host.docker.internal:54321
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=            # clave pública: la usa el frontend (supabase-js en el navegador)
# SUPABASE_SERVICE_ROLE_KEY=    # SECRETA: solo en el servidor, salta las reglas RLS. Nunca al navegador ni al repositorio
# Frontend: con estas dos variables la web inicia sesión con Supabase (supabase-js); sin ellas usa el modo antiguo con cookies.
# Son públicas (la clave anónima va al navegador). En local, ponlas en .env.local con los mismos valores de arriba.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=       # la misma clave anónima (SUPABASE_ANON_KEY)
# ADMIN_EMAILS=tu@correo.com,otra@correo.com   # estos correos pasan a administradores al iniciar sesión por primera vez
#                                              # (también: npm run admin:grant -- correo@ejemplo.com)
# Entrar con Google (desactivado por defecto): crea credenciales OAuth en Google Cloud con la URI de redirección
# http://127.0.0.1:54321/auth/v1/callback, rellena las dos variables y pon enabled = true en
# [auth.external.google] de supabase/config.toml. Después reinicia con `npx supabase stop` y `npx supabase start`.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Correo (recuperar contraseña) ──
# SMTP_URL=smtps://usuario:clave@smtp.tuproveedor.com:465
# MAIL_FROM="FileProyect <no-reply@tudominio.com>"
# Sin SMTP_URL, en desarrollo el enlace de recuperación se imprime en la consola del servidor.

# ── Cobros con Stripe (suscripción Pro) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # endpoint: PUBLIC_URL/api/billing/webhook
# STRIPE_PRICE_MONTH=price_...          # precio recurrente mensual (4,99 €, impuestos incluidos)
# STRIPE_PRICE_YEAR=price_...           # precio recurrente anual (39,99 €, impuestos incluidos)

# ── Solo desarrollo ──
# BILLING_DEV=1                 # activa /api/billing/dev-upgrade para probar Pro sin Stripe. NUNCA en producción

# PORT=3001
# JOBS=3
